# Environment Configuration Template

## Copy this file to .env and update with your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
REACT_APP_VERSION=1.0.0
REACT_APP_MODE=production
REACT_APP_APPLICATION_NAME=Unified Communication

# =============================================================================
# API ENDPOINTS - UPDATE THESE WITH YOUR BACKEND SERVER URLS
# =============================================================================

# Main Services API (for authentication, users, etc.)
REACT_APP_API_BASE_URL=http://localhost:8080/services/api/v2/

# Main Application API (for app-specific endpoints)
REACT_APP_APP_BASE_URL=http://localhost:8080/services/app/v2/

# Telemetry API (for analytics, logging, monitoring)
REACT_APP_TELEMETRY_API_URL=http://localhost:8080/telemetry/api/v2/

# Telemetry Application API
REACT_APP_TELEMETRY_APP_URL=http://localhost:8080/telemetry/app/v2/

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================

# WebSocket endpoint for service messages
REACT_APP_WS_SERVICES=http://localhost:8080/services/app/v2/messaging/messages

# WebSocket endpoint for telemetry messages
REACT_APP_WS_TELEMETRY=http://localhost:8080/telemetry/app/v2/messaging/messages

# =============================================================================
# SIP CONFIGURATION (For VoIP features)
# =============================================================================

# SIP domain for WebRTC connections
REACT_APP_SIP_DOMAIN=localhost

# SIP WebSocket server URL
REACT_APP_SIP_WEBSOCKET=wss://localhost:7443

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Secret key for AES encryption (MUST BE 32 CHARACTERS)
# IMPORTANT: Change this in production!
# Generate a secure key: openssl rand -base64 32
REACT_APP_SECRET_KEY=your-32-character-secret-key-here

# =============================================================================
# SESSION MANAGEMENT
# =============================================================================

# Inactive time before auto-logout (in minutes)
REACT_APP_INACTIVE_TIME=30

# =============================================================================
# PRODUCTION EXAMPLE
# =============================================================================
# 
# For production deployment:
#
# REACT_APP_MODE=production
# REACT_APP_API_BASE_URL=https://api.yourdomain.com/services/api/v2/
# REACT_APP_APP_BASE_URL=https://api.yourdomain.com/services/app/v2/
# REACT_APP_TELEMETRY_API_URL=https://api.yourdomain.com/telemetry/api/v2/
# REACT_APP_TELEMETRY_APP_URL=https://api.yourdomain.com/telemetry/app/v2/
# REACT_APP_WS_SERVICES=https://api.yourdomain.com/services/app/v2/messaging/messages
# REACT_APP_WS_TELEMETRY=https://api.yourdomain.com/telemetry/app/v2/messaging/messages
# REACT_APP_SIP_DOMAIN=sip.yourdomain.com
# REACT_APP_SIP_WEBSOCKET=wss://sip.yourdomain.com:7443
# REACT_APP_SECRET_KEY=GENERATE-A-SECURE-32-CHAR-KEY
#
# =============================================================================

# =============================================================================
# DEVELOPMENT EXAMPLE (with local backend)
# =============================================================================
#
# REACT_APP_MODE=development
# REACT_APP_API_BASE_URL=http://192.168.1.100:8080/services/api/v2/
# REACT_APP_APP_BASE_URL=http://192.168.1.100:8080/services/app/v2/
# REACT_APP_TELEMETRY_API_URL=http://192.168.1.100:8080/telemetry/api/v2/
# REACT_APP_TELEMETRY_APP_URL=http://192.168.1.100:8080/telemetry/app/v2/
# REACT_APP_WS_SERVICES=http://192.168.1.100:8080/services/app/v2/messaging/messages
# REACT_APP_WS_TELEMETRY=http://192.168.1.100:8080/telemetry/app/v2/messaging/messages
# REACT_APP_SIP_DOMAIN=192.168.1.100
# REACT_APP_SIP_WEBSOCKET=wss://192.168.1.100:7443
# REACT_APP_SECRET_KEY=dev-secret-key-32-characters
#
# =============================================================================

# Notes:
# - All REACT_APP_ prefixed variables are accessible in the app via process.env
# - Never commit this file with real credentials to version control
# - Add .env to .gitignore
# - Use different .env files for different environments
# - Restart development server after changing .env values
